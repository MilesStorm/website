*.pt
# yolo26x is 213 MB (> GitHub's 100 MB limit) and unused; yolo26n/26s ship in-repo.
src/model/yolo26x.onnx
runs/
data/yolo_det/
data/yolo_det_self/
# Machine-local CUDA build/runtime env (toolkit version + path differ per box).
.cargo/
# Generated by `export-crops`: the head's training set, minted from dice_face by
# running the real YOLO detector. Regenerable, so not committed.
data/dice_face_crops/
# Python bytecode from tools/.
tools/__pycache__/
# Backups written by the review pages; crop_overrides.tsv itself IS tracked (owner's label review).
crop_overrides.tsv.bak
# Model weights ship as GitHub Release assets, never in git (no LFS).
*.safetensors
*.npy
