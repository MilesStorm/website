  "components": {
    "schemas": {
      "AccountInfo": {
        "description": "The logged-in user's account settings.",
        "type": "object",
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "description": "`None` for accounts without one (GitHub logins).",
            "type": [
              "string",
              "null"
            ]
          },
          "email_verified": {
            "type": "boolean"
          },
          "picture_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "picture_version": {
            "description": "Version of the profile picture (the `?v=` of `picture_url`), `None` when there is none.",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "pictures_available": {
            "description": "False when the picture store isn't reachable or configured.",
            "type": "boolean"
          },
          "shown_name": {
            "description": "The display name, or the username when there is none.",
            "type": "string"
          },
          "username": {
            "description": "Login name; can't be changed.",
            "type": "string"
          }
        },
        "required": [
          "username",
          "display_name",
          "shown_name",
          "picture_version",
          "picture_url",
          "pictures_available",
          "email",
          "email_verified"
        ]
      },
      "ApiError": {
        "description": "Every error the API answers: `{\"error\": \"logged_out\", \"message\": \"...\"}` with a 4xx or 5xx\nstatus. `message` is for the user. A 5xx message never carries the internal error, which\ngoes only to the log.",
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "Bootstrap": {
        "description": "Who is looking at the page: what `GET /api/session` answers.",
        "type": "object",
        "properties": {
          "viewer": {
            "description": "`None` when logged out.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/Viewer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "viewer"
        ]
      },
      "Code": {
        "description": "A one-time code from an emailed link or an invite link.",
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "Confirmed": {
        "description": "An address confirmed with an emailed code: whose.",
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ]
      },
      "Deleted": {
        "description": "How many shared rolls were deleted.",
        "type": "object",
        "properties": {
          "deleted": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "deleted"
        ]
      },
      "Deletion": {
        "description": "What a delete-account link is for, before it is used.",
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ]
      },
      "DirectDeletion": {
        "description": "`POST /api/account/deletion/direct`: `confirm` must be the username.",
        "type": "object",
        "properties": {
          "confirm": {
            "type": "string"
          }
        },
        "required": [
          "confirm"
        ]
      },
      "DisplayName": {
        "description": "`PUT /api/account/display-name`. Blank clears it.",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "Done": {
        "description": "After resetting a password or deleting an account: whether this browser's session was that\naccount's and has been logged out.",
        "type": "object",
        "properties": {
          "logged_out": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "logged_out"
        ]
      },
      "EmailSent": {
        "description": "Where an email was sent.",
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ErrorCode": {
        "description": "What kind of failure an [`ApiError`] is: for the code paths that branch on it. The rest is\nin the message. Clients send the user to the login page on `logged_out` only, never on a\n401 alone: a wrong password is a 401 too (`invalid`).",
        "type": "string",
        "enum": [
          "logged_out",
          "forbidden",
          "invalid",
          "conflict",
          "not_found",
          "gone",
          "rate_limited",
          "unavailable",
          "upstream",
          "internal"
        ]
      },
      "ForgotPassword": {
        "description": "`POST /api/password/forgot`: a username or an email address.",
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          }
        },
        "required": [
          "login"
        ]
      },
      "KnownPermission": {
        "description": "The permissions the site knows. Every permission check uses this closed set, so TypeScript\ngets a literal union.",
        "type": "string",
        "enum": [
          "llama",
          "enshrouded",
          "arcane",
          "manage_permissions"
        ]
      },
      "LoggedIn": {
        "description": "A login or registration that succeeded.",
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ]
      },
      "Login": {
        "description": "`POST /api/session/login`.",
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "Opened": {
        "description": "What opening an invite link did.",
        "oneOf": [
          {
            "description": "The logged-in user now has `role` (or already had it through this link).",
            "type": "object",
            "properties": {
              "group_label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "joined"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "role",
              "group_label"
            ]
          },
          {
            "description": "Logged out: the invite is kept until they log in or sign up.",
            "type": "object",
            "properties": {
              "group_label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "needs_account"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "role",
              "group_label"
            ]
          }
        ]
      },
      "PasswordReset": {
        "description": "`POST /api/password/reset`.",
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "password"
        ]
      },
      "PictureVersion": {
        "description": "A profile picture just stored.",
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "version"
        ]
      },
      "Registration": {
        "description": "`POST /api/session/register`: a new account, logged in at once.",
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "Sharing": {
        "description": "`PUT /api/account/sharing`.",
        "type": "object",
        "properties": {
          "share": {
            "type": "boolean"
          }
        },
        "required": [
          "share"
        ]
      },
      "SharingState": {
        "type": "object",
        "properties": {
          "available": {
            "description": "False when the training-data store isn't configured on this server.",
            "type": "boolean"
          },
          "share": {
            "type": "boolean"
          }
        },
        "required": [
          "available",
          "share"
        ]
      },
      "Viewer": {
        "description": "The logged-in user, as the page shows them.",
        "type": "object",
        "properties": {
          "permissions": {
            "description": "Only the ones the site knows; empty when auth can't be reached.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KnownPermission"
            }
          },
          "picture_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "shown_name": {
            "description": "The display name, or the username when there is none.",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "shown_name",
          "picture_url",
          "permissions"
        ]
      }
    }
  }
}
