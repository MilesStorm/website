---
import Layout from '@/layouts/Layout.astro';
import Page from '@/components/Page.astro';
import { Profile } from '@/islands/Profile';
import { ProfileSkeleton } from '@/islands/ProfileSkeleton';
---

<Layout title="Profile">
  <Page measure="profile" title="Profile" description="Your account, and how this site looks for you.">
    <Profile client:only="react">
      <ProfileSkeleton slot="fallback" />
    </Profile>
  </Page>
</Layout>
