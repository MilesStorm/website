---
import Layout from '@/layouts/Layout.astro';
import Page from '@/components/Page.astro';
import { Card, CardAction, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { ModeToggle } from '@/islands/ModeToggle';
import { Profile } from '@/islands/Profile';
import { ProfileSkeleton } from '@/islands/ProfileSkeleton';
---

<Layout title="Profile">
  <Page title="Profile" description="Your account, and how this site looks for you.">
    <Profile client:only="react">
      <ProfileSkeleton slot="fallback" />
    </Profile>
    <Card>
      <CardHeader>
        <CardTitle><h2>Site theme</h2></CardTitle>
        <CardDescription>Saved in this browser.</CardDescription>
        <CardAction><ModeToggle client:load /></CardAction>
      </CardHeader>
    </Card>
  </Page>
</Layout>
