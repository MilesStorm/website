---
import Layout from '@/layouts/Layout.astro';
import { Countdown } from '@/islands/Countdown';
---

<Layout title="MilesStorm: countdown">
  <main class="flex min-h-[60vh] flex-col items-center justify-center gap-4 px-4 text-center">
    <h1 class="text-2xl font-bold">⏳ Time until Miles stops being an asshole</h1>
    <Countdown client:only="react">
      <p slot="fallback" class="text-sm text-muted-foreground">calculating...</p>
    </Countdown>
  </main>
</Layout>
