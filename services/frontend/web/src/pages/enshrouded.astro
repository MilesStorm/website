---
import Layout from '@/layouts/Layout.astro';
import Page from '@/components/Page.astro';
import { EnshroudedPanel } from '@/islands/EnshroudedPanel';
import { EnshroudedSkeleton } from '@/islands/EnshroudedSkeleton';
---

<Layout title="Enshrouded">
  <Page measure="enshrouded">
    <EnshroudedPanel client:only="react">
      <EnshroudedSkeleton slot="fallback" />
    </EnshroudedPanel>
  </Page>
</Layout>
