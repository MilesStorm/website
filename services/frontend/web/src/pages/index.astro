---
import Layout from '@/layouts/Layout.astro';
import Gate from '@/components/Gate.astro';
import { Storm } from '@/islands/Storm';
import { CARD_GRID, FeatureCard } from '@/components/FeatureCard';
import { badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { HomeCards } from '@/islands/HomeCards';
import { HERO_SECTION, HomeSkeleton } from '@/islands/HomeSkeleton';
import { previewCards } from '@/lib/features';
import { cn } from '@/lib/utils';
---

<Layout title="MilesStorm">
  <main class="relative isolate">
    <Gate session="out" class="mx-auto flex max-w-5xl flex-col gap-4 px-4 pb-16 md:px-6">
      <section class={HERO_SECTION}>
        <Storm client:idle />
        <p class={cn(badgeVariants({ variant: 'secondary' }), 'mb-2 h-6 px-2.5')}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13 2 4 14h7l-1 8 9-12h-7z"></path>
          </svg>
          MilesStorm
        </p>
        <h1
          class="max-w-4xl text-4xl leading-tight font-semibold tracking-tight text-balance text-primary md:text-5xl lg:leading-[1.1] xl:tracking-tighter"
        >
          Tools for game nights with friends.
        </h1>
        <p class="max-w-2xl text-base text-balance text-foreground sm:text-lg">
          A dice reader that follows your real rolls, and more for invited accounts.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-2 pt-4">
          <a href="/login" class={buttonVariants()}>Log in</a>
          <a href="/register" class={buttonVariants({ variant: 'outline' })}>Create an account</a>
        </div>
        <p class="pt-2 text-sm text-muted-foreground">Early access: features are unlocked for invited accounts.</p>
      </section>
      <section class={CARD_GRID}>
        {previewCards().map((feature) => <FeatureCard feature={feature} state="preview" />)}
      </section>
    </Gate>
    <Gate session="in" class="mx-auto max-w-5xl px-4 pb-16 md:px-6">
      <HomeCards client:only="react">
        <HomeSkeleton slot="fallback" />
      </HomeCards>
    </Gate>
  </main>
</Layout>
