---
import Layout from '@/layouts/Layout.astro';
import Gate from '@/components/Gate.astro';
import Storm from '@/components/Storm.astro';
import { FeatureCard } from '@/components/FeatureCard';
import { buttonVariants } from '@/components/ui/button';
import { HomeCards } from '@/islands/HomeCards';
import { HomeSkeleton } from '@/islands/HomeSkeleton';
import { previewCards } from '@/lib/features';
---

<Layout title="MilesStorm">
  <main class="mx-auto max-w-5xl px-4 pt-8 pb-16">
    <Gate session="out" class="flex flex-col gap-10">
      <section class="relative overflow-hidden rounded-xl border bg-card px-6 py-16 shadow-xs sm:px-12 sm:py-20">
        <Storm />
        <div class="relative max-w-2xl">
          <p class="flex items-center gap-1.5 text-sm font-semibold tracking-widest text-muted-foreground uppercase">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
              <path d="M13 2 4 14h7l-1 8 9-12h-7z"></path>
            </svg>
            MilesStorm
          </p>
          <h1 class="mt-3 text-4xl leading-tight font-extrabold sm:text-5xl">Tools for game nights with friends.</h1>
          <p class="mt-4 text-lg text-muted-foreground">
            A dice reader that follows your real rolls, and more for invited accounts.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/login" class={buttonVariants({ size: 'lg' })}>Log in</a>
            <a href="/register" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Create an account</a>
          </div>
          <p class="mt-6 text-sm text-muted-foreground">Early access: features are unlocked for invited accounts.</p>
        </div>
      </section>
      <section class="grid gap-4 sm:grid-cols-2">
        {previewCards().map((feature) => <FeatureCard feature={feature} state="preview" />)}
      </section>
    </Gate>
    <Gate session="in">
      <HomeCards client:only="react">
        <HomeSkeleton slot="fallback" />
      </HomeCards>
    </Gate>
  </main>
</Layout>
