---
import Layout from '@/layouts/Layout.astro';
import Page from '@/components/Page.astro';
import { ArkPanel } from '@/islands/ArkPanel';
import { ArkSkeleton } from '@/islands/ArkSkeleton';
---

<Layout title="Ark">
  <Page title="Ark server" description="Who's online, and start, stop or restart the server." width="narrow">
    <ArkPanel client:only="react">
      <ArkSkeleton slot="fallback" />
    </ArkPanel>
  </Page>
</Layout>
