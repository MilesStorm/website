---
import Layout from '@/layouts/Layout.astro';
import StatusPage from '@/components/StatusPage.astro';
import { buttonVariants } from '@/components/ui/button';
---

<Layout title="Unavailable">
  <StatusPage code={503} title="Can't check your access right now">
    <p>The login service isn't answering. Try again in a moment.</p>
    <a slot="actions" href="/" class={buttonVariants({ variant: 'outline' })}>Go home</a>
  </StatusPage>
</Layout>
