---
import Layout from '@/layouts/Layout.astro';
import Page from '@/components/Page.astro';
import { ArcaneCamera } from '@/islands/ArcaneCamera';
import { ArcaneSkeleton } from '@/islands/ArcaneSkeleton';
---

<Layout title="Arcane dice">
  <Page title="Arcane dice reader" description="Roll in view of the camera: it reads the dice and adds them up.">
    <ArcaneCamera client:only="react">
      <ArcaneSkeleton slot="fallback" />
    </ArcaneCamera>
  </Page>
</Layout>
