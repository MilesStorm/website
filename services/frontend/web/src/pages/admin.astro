---
import Layout from '@/layouts/Layout.astro';
import { Skeleton } from '@/components/ui/skeleton';
import { AdminPanel } from '@/islands/AdminPanel';
---

<Layout title="Admin">
  <main class="mx-auto flex max-w-5xl flex-col gap-6 px-4 pt-10 pb-16">
    <h1 class="text-2xl font-bold">Admin</h1>
    <AdminPanel client:only="react">
      <Skeleton slot="fallback" className="h-96 w-full rounded-xl" />
    </AdminPanel>
  </main>
</Layout>
