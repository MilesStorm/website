---
import Layout from '@/layouts/Layout.astro';
import Panel from '@/components/Panel.astro';
import { ResetSkeleton } from '@/islands/FormSkeleton';
import { ResetForm } from '@/islands/ResetForm';
---

<Layout title="Choose a new password" noReferrer>
  <Panel title="Choose a new password" description="Changing it logs your account out everywhere.">
    <ResetForm client:only="react">
      <ResetSkeleton slot="fallback" />
    </ResetForm>
  </Panel>
</Layout>
