---
// The same markup for everyone: Gate shows the right parts from the attributes the server put on
// <html>, before any script runs.
import { Menu } from 'lucide-react';
import Gate from './Gate.astro';
import Logo from './Logo.astro';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { cn } from '@/lib/utils';
import { CONTAINER } from '@/lib/layout';
import { ModeToggle } from '@/islands/ModeToggle';
import { UserMenu } from '@/islands/UserMenu';
import type { KnownPermission } from '@/api/session';
import type { Href } from '@/lib/pages';

const LINKS: { href: Href; label: string; requires: KnownPermission }[] = [
  { href: '/ark', label: 'Ark', requires: 'llama' },
  { href: '/enshrouded', label: 'Enshrouded', requires: 'enshrouded' },
  { href: '/arcane', label: 'Arcane', requires: 'arcane' },
  { href: '/admin', label: 'Admin', requires: 'manage_permissions' },
];
// shadcn's site header (ui.shadcn.com): plain background, no rule under it, ghost links. Like
// the site's, the links are muted and the current page's (`aria-current`) is in the foreground.
const link = cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'text-muted-foreground aria-[current=page]:text-foreground');
// The menu below it is a popover like the user menu's: rounded items, the current one marked.
const item =
  'flex rounded-xl px-3 py-2 text-sm text-muted-foreground outline-none hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground aria-[current=page]:bg-muted aria-[current=page]:font-medium aria-[current=page]:text-foreground';
// Built as files (`build.format: 'file'`): /login.html is /login, /index.html is /.
const here = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const current = (href: Href) => (href === here ? 'page' : undefined);
---

<!-- Translucent and blurred, like ui.shadcn.com's header, and fading out over its last 20px (the mask
     takes its blur with it): the storm behind the hero and the page scrolling under the header
     pass behind it with no edge where they meet it. Plain background where the browser can't blur.
     The background is a layer of its own: a mask on the header would also hide the phone menu,
     which hangs below it. -->
<header class="sticky top-0 z-40 isolate w-full">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-background supports-[backdrop-filter]:bg-background/60 supports-[backdrop-filter]:backdrop-blur-md supports-[backdrop-filter]:[mask-image:linear-gradient(to_bottom,#000_calc(100%-20px),transparent)]"></div>
  <nav aria-label="Main" class:list={[CONTAINER, 'flex h-16 items-center gap-2']}>
    <a href="/" class="mr-4 flex items-center gap-2 font-semibold">
      <Logo class="size-6" />
      <span>MilesStorm</span>
    </a>
    <ul class="hidden items-center md:flex">
      <li><a href="/" class={link} aria-current={current('/')}>Home</a></li>
      {
        LINKS.map((l) => (
          <Gate as="li" requires={l.requires}>
            <a href={l.href} class={link} aria-current={current(l.href)}>
              {l.label}
            </a>
          </Gate>
        ))
      }
    </ul>
    <div class="ml-auto flex items-center gap-2">
      <ModeToggle client:load />
      <div class="flex h-4"><Separator orientation="vertical" /></div>
      <Gate session="out" class="flex items-center gap-2">
        <a href="/login" class={cn(link, 'hidden sm:inline-flex')}>Log in</a>
        <a href="/register" class={buttonVariants({ size: 'sm' })}>Register</a>
      </Gate>
      <Gate session="in">
        <UserMenu client:only="react">
          <span slot="fallback" class="block size-9" aria-hidden="true"></span>
        </UserMenu>
      </Gate>
      <details class="group relative md:hidden">
        <summary class={buttonVariants({ variant: 'ghost', size: 'icon' }) + ' list-none [&::-webkit-details-marker]:hidden'} aria-label="Menu">
          <Menu aria-hidden="true" />
        </summary>
        <ul class="absolute right-0 mt-2 flex w-48 origin-top-right flex-col rounded-2xl bg-popover p-1 text-popover-foreground shadow-2xl ring-1 ring-foreground/5 duration-100 group-open:animate-in group-open:fade-in-0 group-open:zoom-in-95 dark:ring-foreground/10">
          <li><a href="/" class={item} aria-current={current('/')}>Home</a></li>
          {
            LINKS.map((l) => (
              <Gate as="li" requires={l.requires}>
                <a href={l.href} class={item} aria-current={current(l.href)}>
                  {l.label}
                </a>
              </Gate>
            ))
          }
          <Gate as="li" session="in"><a href="/profile" class={item} aria-current={current('/profile')}>Profile</a></Gate>
          <Gate as="li" session="out" class="sm:hidden"><a href="/login" class={item}>Log in</a></Gate>
        </ul>
      </details>
    </div>
  </nav>
</header>
