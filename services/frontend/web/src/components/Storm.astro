---
// The storm behind a hero: a soft glow and a faint rain of dots fading towards the bottom.
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0">
  <div class="absolute -top-28 -right-20 size-80 rounded-full bg-foreground/10 blur-3xl"></div>
  <div
    class="absolute inset-0 opacity-60 [background-image:radial-gradient(color-mix(in_oklab,var(--foreground)_18%,transparent)_1px,transparent_1px)] [background-size:18px_18px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"
  >
  </div>
</div>
