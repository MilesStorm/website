{
  "name": "milesstorm-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "tracing": "node scripts/tracing.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/sourcemaps.mjs && node scripts/precompress.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:trace": "node --test assets/trace.test.mjs",
    "e2e": "playwright test",
    "api": "cd .. && cargo run -q -p bff --bin server -- openapi > web/src/api/openapi.json && cd web && npm run api:types",
    "api:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@grafana/faro-react": "2.12.1",
    "@hookform/resolvers": "5.9.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.89.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@grafana/faro-web-sdk": "2.12.1",
    "@grafana/faro-web-tracing": "2.12.1",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "shadcn": "4.22.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
