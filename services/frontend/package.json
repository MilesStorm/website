{
  "dependencies": {
    "@grafana/faro-web-sdk": "2.12.1",
    "@grafana/faro-web-tracing": "2.12.1",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@tailwindcss/cli": "^4.2.2",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.2"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "test:trace": "node --test packages/web/assets/trace.test.mjs",
    "api": "cargo run -q -p web --features web/server -- openapi > web/src/api/openapi.json && npm run api:types",
    "api:types": "openapi-typescript web/src/api/openapi.json -o web/src/api/schema.d.ts"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
