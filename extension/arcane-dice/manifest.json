{
  "manifest_version": 3,
  "name": "Arcane Dice",
  "version": "0.4.1",
  "icons": {
    "16": "icons/arcane-eye-16.png",
    "32": "icons/arcane-eye-32.png",
    "48": "icons/arcane-eye-48.png",
    "96": "icons/arcane-eye-96.png",
    "128": "icons/arcane-eye-128.png"
  },
  "description": "Shows your latest dice roll from the Arcane dice tray on milesstorm.com, and types it into Roll20's chat.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arcane-dice@milesstorm.com",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/MilesStorm/website/releases/download/arcane-dice/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "minimum_chrome_version": "121",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://milesstorm.com/*",
    "https://app.roll20.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/editor*"
      ],
      "js": [
        "roll20.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/arcane-eye-16.png",
      "32": "icons/arcane-eye-32.png"
    },
    "default_title": "Latest dice roll",
    "default_popup": "popup.html"
  }
}
