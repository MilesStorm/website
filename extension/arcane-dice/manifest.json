{
  "manifest_version": 3,
  "name": "Arcane Dice",
  "version": "0.2.0",
  "description": "Shows your latest dice roll from the Arcane dice tray on milesstorm.com.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arcane-dice@milesstorm.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://milesstorm.com/*"
  ],
  "action": {
    "default_title": "Latest dice roll",
    "default_popup": "popup.html"
  }
}
